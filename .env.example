# ── Foundry Local Configuration ──────────────────────────────────────
# Model alias — Foundry Local picks the best hardware variant automatically.
# Run `foundry model list` to see available aliases.
MODEL_ALIAS=qwen2.5-7b

# (Optional) Override the Foundry Local endpoint if already running.
# Leave blank to let the SDK start the service automatically.
# FOUNDRY_LOCAL_ENDPOINT=http://localhost:5272/v1

# ── App Settings ────────────────────────────────────────────────────
# Folder containing documents the Retriever agent will read.
DOCS_PATH=./data

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
